<div class="sig-workspace">
  <header class="sig-heading">
    <div><p class="sig-eyebrow">GESTÃO DE INSPEÇÕES</p><h1>SIG-UHE</h1><p class="sig-muted">Usinas, reservatórios e operações de campo</p></div>
    <div class="sig-heading-actions"><span class="sig-live"><span></span> Ambiente de desenvolvimento</span><Button @icon="rotate" @text="Atualizar" @onClick={{this.refresh}} @disabled={{this.busy}} /></div>
  </header>
  <nav class="sig-tabs" aria-label="Navegação SIG-UHE">
    {{#each this.tabs as |tab|}}<button type="button" class="sig-tab {{if tab.active 'sig-tab-active'}}" aria-current={{if tab.active "page"}} disabled={{this.busy}} {{on "click" (fn this.navigate tab.id)}}><FaIcon @icon={{tab.icon}} /><span>{{tab.label}}</span></button>{{/each}}
  </nav>
  {{#if this.error}}<div class="sig-alert sig-error" role="alert"><FaIcon @icon="triangle-exclamation" /><span>{{this.error}}</span></div>{{/if}}
  {{#if this.notice}}<div class="sig-alert sig-success" role="status"><FaIcon @icon="circle-check" /><span>{{this.notice}}</span></div>{{/if}}
  {{#if this.busy}}<p class="sig-loading" role="status"><Spinner /> Carregando registros…</p>{{/if}}
  {{#if this.form}}
    <section class="sig-card sig-form-card" aria-labelledby="sig-form-title">
      <div class="sig-card-heading"><div><p class="sig-eyebrow">CADASTRO OPERACIONAL</p><h2 id="sig-form-title">{{this.formTitle}}</h2></div><Button @text="Cancelar" @onClick={{this.close}} @disabled={{this.saving}} /></div>
      <form {{on "submit" this.save}}>
        <fieldset disabled={{this.saving}} class="sig-fields">
{{#if this.isPlantForm}}<div class="sig-field"><label for="sig-code">Código da UHE</label><input id="sig-code" name="code" type="text" value={{this.formData.code}} class="form-input" {{on "input" (fn this.updateField "code")}} required maxlength="30" placeholder="Ex.: CN1" /></div><div class="sig-field"><label for="sig-name">Nome da UHE</label><input id="sig-name" name="name" type="text" value={{this.formData.name}} class="form-input" {{on "input" (fn this.updateField "name")}} required maxlength="160" placeholder="Ex.: Canoas I" /></div><div class="sig-field"><label for="sig-state">UF</label><select id="sig-state" name="state" class="form-select" {{on "change" (fn this.updateField "state")}} required>{{#each this.states as |state|}}<option value={{state}} selected={{eq state this.formData.state}}>{{state}}</option>{{/each}}</select></div>{{/if}}{{#if this.isReservoirForm}}<div class="sig-field"><label for="sig-plant_id">UHE</label><select id="sig-plant_id" name="plant_id" class="form-select" {{on "change" (fn this.updateField "plant_id")}} required><option value="">Selecione uma UHE</option>{{#each this.plants as |plant|}}<option value={{plant.id}}>{{plant.name}}</option>{{/each}}</select></div><div class="sig-field"><label for="sig-name">Nome do reservatório</label><input id="sig-name" name="name" type="text" value={{this.formData.name}} class="form-input" {{on "input" (fn this.updateField "name")}} required maxlength="160" /></div>{{/if}}{{#if this.isProfileForm}}
<div class="sig-inline-note sig-full"><strong>{{this.profileTeam.name}}</strong><p>Cadastre a base e os horários locais da equipe. A programação automática será uma etapa posterior.</p></div>
<fieldset class="sig-full sig-profile-fields" disabled={{this.profileReadOnly}}>
<div class="sig-field"><label for="sig-availability">Disponibilidade operacional</label><select id="sig-availability" class="form-select" {{on "change" (fn this.updateField "availability")}}><option value="unavailable" selected={{eq this.formData.availability "unavailable"}}>Indisponível</option><option value="available" selected={{eq this.formData.availability "available"}}>Disponível</option></select></div>
<div class="sig-field"><label for="sig-timezone">Fuso horário</label><input id="sig-timezone" class="form-input" type="text" value={{this.formData.timezone}} {{on "input" (fn this.updateField "timezone")}} required placeholder="America/Sao_Paulo" /></div>
<div class="sig-field"><label for="sig-profile-lat">Latitude da base operacional</label><input id="sig-profile-lat" class="form-input" type="number" step="any" min="-90" max="90" required value={{this.formData.base_latitude}} {{on "input" (fn this.updateField "base_latitude")}} /></div>
<div class="sig-field"><label for="sig-profile-lng">Longitude da base operacional</label><input id="sig-profile-lng" class="form-input" type="number" step="any" min="-180" max="180" required value={{this.formData.base_longitude}} {{on "input" (fn this.updateField "base_longitude")}} /></div>
<div class="sig-field"><label for="sig-capacity">Capacidade diária para serviços (minutos)</label><input id="sig-capacity" class="form-input" type="number" min="1" max="1440" step="1" required value={{this.formData.daily_capacity_minutes}} {{on "input" (fn this.updateField "daily_capacity_minutes")}} /><p class="sig-help">Não pode exceder a soma das jornadas de nenhum dia cadastrado.</p></div>
<div class="sig-field"><span>Habilidades da equipe</span>{{#each this.skillOptions as |skill|}}<label class="sig-check"><input type="checkbox" checked={{skill.checked}} {{on "change" (fn this.toggleSkill skill.value)}} /> {{skill.label}}</label>{{/each}}</div>
<div class="sig-full"><h3>Jornada semanal</h3><p class="sig-help">Horários no fuso informado. Cadastre intervalos separados para descontar almoço e pausas. Plantões que cruzam meia-noite devem ser divididos entre os dias.</p>
{{#each this.formData.weekly_windows as |window index|}}<div class="sig-window-row"><div class="sig-field"><label for="sig-day-{{index}}">Dia da semana</label><select id="sig-day-{{index}}" class="form-select" {{on "change" (fn this.updateWindow index "day")}}>{{#each this.weekdays as |day|}}<option value={{day.value}} selected={{eq day.value window.day}}>{{day.label}}</option>{{/each}}</select></div><div class="sig-field"><label for="sig-start-{{index}}">Início</label><input id="sig-start-{{index}}" type="time" class="form-input" required value={{window.start}} {{on "input" (fn this.updateWindow index "start")}} /></div><div class="sig-field"><label for="sig-end-{{index}}">Fim</label><input id="sig-end-{{index}}" type="time" class="form-input" required value={{window.end}} {{on "input" (fn this.updateWindow index "end")}} /></div>{{#if this.canWrite}}<Button @text="Remover intervalo" @onClick={{fn this.removeWindow index}} />{{/if}}</div>{{else}}<p class="sig-help">Nenhuma jornada cadastrada.</p>{{/each}}
{{#if this.canWrite}}<Button @text="Adicionar intervalo" @icon="plus" @onClick={{this.addWindow}} @disabled={{gte this.formData.weekly_windows.length 28}} />{{/if}}</div>
{{#if this.canWrite}}<div class="sig-field sig-full"><label for="sig-profile-reason">Motivo da alteração operacional</label><input id="sig-profile-reason" type="text" class="form-input" required maxlength="2000" value={{this.formData.reason}} {{on "input" (fn this.updateField "reason")}} /></div>{{/if}}
</fieldset>{{/if}}{{#if this.isTeamForm}}<div class="sig-field"><label for="sig-name">Nome da equipe</label><input id="sig-name" name="name" type="text" value={{this.formData.name}} class="form-input" {{on "input" (fn this.updateField "name")}} required maxlength="160" placeholder="Ex.: Equipe de inspeção ambiental" /></div><p class="sig-help sig-full">A equipe será registrada no Fleet-Ops. Inspetores, veículos e atribuições serão administrados pelo módulo operacional.</p>{{/if}}{{#if this.isRequestForm}}<div class="sig-field"><label for="sig-reservoir_id">Reservatório</label><select id="sig-reservoir_id" name="reservoir_id" class="form-select" {{on "change" (fn this.updateField "reservoir_id")}} required><option value="">Selecione um reservatório</option>{{#each this.reservoirRows as |reservoir|}}<option value={{reservoir.id}}>{{reservoir.plantName}} · {{reservoir.name}}</option>{{/each}}</select></div><div class="sig-field"><label for="sig-protocol">Protocolo</label><input id="sig-protocol" name="protocol" type="text" value={{this.formData.protocol}} class="form-input" {{on "input" (fn this.updateField "protocol")}} required maxlength="80" /></div><div class="sig-field"><label for="sig-category">Categoria</label><input id="sig-category" name="category" type="text" value={{this.formData.category}} class="form-input" {{on "input" (fn this.updateField "category")}} required maxlength="80" placeholder="Ex.: Rampa de acesso" /></div><div class="sig-field"><label for="sig-priority">Prioridade</label><select id="sig-priority" name="priority" class="form-select" {{on "change" (fn this.updateField "priority")}} required><option value="low">Baixa</option><option value="normal" selected>Normal</option><option value="high">Alta</option><option value="urgent">Urgente</option></select></div><div class="sig-field sig-full"><label for="sig-description">Descrição da inspeção</label><textarea id="sig-description" name="description" class="form-input" rows="3" required maxlength="10000" value={{this.formData.description}} {{on "input" (fn this.updateField "description")}}></textarea></div><div class="sig-field"><label for="sig-latitude">Latitude da ocorrência</label><input id="sig-latitude" name="latitude" type="number" value={{this.formData.latitude}} class="form-input" {{on "input" (fn this.updateField "latitude")}} required min="-90" max="90" step="any" placeholder="-23.0000000" /></div><div class="sig-field"><label for="sig-longitude">Longitude da ocorrência</label><input id="sig-longitude" name="longitude" type="number" value={{this.formData.longitude}} class="form-input" {{on "input" (fn this.updateField "longitude")}} required min="-180" max="180" step="any" placeholder="-50.0000000" /></div><div class="sig-field"><label for="sig-access_latitude">Latitude do acesso terrestre</label><input id="sig-access_latitude" name="access_latitude" type="number" value={{this.formData.access_latitude}} class="form-input" {{on "input" (fn this.updateField "access_latitude")}} min="-90" max="90" step="any" /></div><div class="sig-field"><label for="sig-access_longitude">Longitude do acesso terrestre</label><input id="sig-access_longitude" name="access_longitude" type="number" value={{this.formData.access_longitude}} class="form-input" {{on "input" (fn this.updateField "access_longitude")}} min="-180" max="180" step="any" /></div><div class="sig-field"><label for="sig-service_seconds">Duração estimada (segundos)</label><input id="sig-service_seconds" name="service_seconds" type="number" value={{this.formData.service_seconds}} class="form-input" {{on "input" (fn this.updateField "service_seconds")}} required min="60" max="86400" step="1" /></div><p class="sig-help sig-full">As coordenadas da ocorrência e do acesso são diferentes. Se o acesso ainda não for conhecido, deixe os dois campos de acesso vazios; a emissão de OS ficará bloqueada.</p>{{/if}}{{#if this.isOrderForm}}<div class="sig-inline-note sig-full"><strong>{{this.selected.protocol}}</strong><p>Informe a base operacional de saída. O destino será o acesso cadastrado. A emissão cria a OS sem calcular rota ou despachar a equipe.</p></div><div class="sig-field"><label for="sig-base_latitude">Latitude da base</label><input id="sig-base_latitude" name="base_latitude" type="number" value={{this.formData.base_latitude}} class="form-input" {{on "input" (fn this.updateField "base_latitude")}} required min="-90" max="90" step="any" /></div><div class="sig-field"><label for="sig-base_longitude">Longitude da base</label><input id="sig-base_longitude" name="base_longitude" type="number" value={{this.formData.base_longitude}} class="form-input" {{on "input" (fn this.updateField "base_longitude")}} required min="-180" max="180" step="any" /></div>{{/if}}{{#if this.isStatusForm}}<div class="sig-field"><label for="sig-status">Nova situação</label><select id="sig-status" name="status" class="form-select" {{on "change" (fn this.updateField "status")}} required>{{#each this.nextStatuses as |status|}}<option value={{status.value}}>{{status.label}}</option>{{/each}}</select></div><div class="sig-field"><label for="sig-reason">Justificativa</label><input id="sig-reason" name="reason" type="text" value={{this.formData.reason}} class="form-input" {{on "input" (fn this.updateField "reason")}} required maxlength="2000" /></div><p class="sig-help sig-full">A alteração será registrada no histórico. A situação da solicitação é independente da situação de suas OS.</p>{{/if}}</fieldset>{{#unless this.profileReadOnly}}<div class="sig-form-footer"><Button @buttonType="submit" @type="primary" @text="Salvar registro" @isLoading={{this.saving}} @disabled={{this.saving}} /></div>{{/unless}}</form></section>
  {{else}}
    {{#if this.isOverview}}
      <div class="sig-stats">
        <article class="sig-stat"><span>UHEs cadastradas</span><strong>{{or this.summary.plants 0}}</strong><small>Empreendimentos da organização</small></article>
        <article class="sig-stat"><span>Solicitações pendentes</span><strong>{{or this.summary.pending_requests 0}}</strong><small>Abertas e em atendimento</small></article>
        <article class="sig-stat"><span>Ordens emitidas</span><strong>{{or this.summary.orders 0}}</strong><small>Vinculadas às solicitações</small></article>
        <article class="sig-stat"><span>Equipes</span><strong>{{or this.summary.teams 0}}</strong><small>Cadastros no Fleet-Ops</small></article>
      </div>
      <section class="sig-card sig-intro"><div class="sig-intro-icon"><FaIcon @icon="water" /></div><div><p class="sig-eyebrow">CENTRO DE OPERAÇÕES</p><h2>Da solicitação à ordem de serviço</h2><p class="sig-muted">Centralize as inspeções dos reservatórios, registre o ponto de acesso e acompanhe as solicitações com rastreabilidade.</p><div class="sig-intro-actions"><Button @type="primary" @text="Ver solicitações" @icon="arrow-right" @onClick={{fn this.navigate "requests"}} /><Button @text="Gerenciar UHEs" @onClick={{fn this.navigate "plants"}} /></div></div></section>
      <section class="sig-card"><div class="sig-card-heading"><h2>Próximas etapas operacionais</h2></div><div class="sig-steps"><div><span>01</span><h3>Organize os locais</h3><p>Cadastre a usina e seus reservatórios.</p></div><div><span>02</span><h3>Registre a demanda</h3><p>Crie uma solicitação ou importe um CSV.</p></div><div><span>03</span><h3>Emita e acompanhe</h3><p>Gere a OS e consulte o histórico das alterações.</p></div></div></section>
    {{/if}}
    {{#if this.isRequests}}
      <section class="sig-card"><div class="sig-card-heading"><div><h2>Solicitações de inspeção</h2><p class="sig-muted">{{this.total}} registros encontrados</p></div>{{#if this.canWrite}}<Button @type="primary" @icon="plus" @text="Nova solicitação" @onClick={{fn this.openForm "request"}} @disabled={{this.busy}} />{{/if}}</div>
      <form class="sig-filters" {{on "submit" this.search}}><div class="sig-field"><label for="sig-search">Pesquisar</label><input id="sig-search" type="search" class="form-input" placeholder="Protocolo ou descrição" value={{this.query}} {{on "input" this.updateQuery}} /></div><div class="sig-field"><label for="sig-status-filter">Situação</label><select id="sig-status-filter" class="form-select" {{on "change" this.updateStatus}}><option value="">Todas as situações</option>{{#each this.statusOptions as |status|}}<option value={{status.value}} selected={{eq status.value this.status}}>{{status.label}}</option>{{/each}}</select></div><Button @text="Filtrar" @icon="filter" @buttonType="submit" @disabled={{this.busy}} /></form>
      {{#if this.selectedDetailVisible}}<section class="sig-detail" aria-label="Detalhes da solicitação"><div class="sig-card-heading"><div><p class="sig-eyebrow">SOLICITAÇÃO</p><h3>{{this.selected.protocol}}</h3></div><Button @text="Fechar detalhes" @onClick={{this.close}} /></div><p>{{this.selected.description}}</p><dl class="sig-detail-grid"><div><dt>Situação</dt><dd>{{this.selectedStatus}}</dd></div><div><dt>Ocorrência</dt><dd>{{this.selected.latitude}}, {{this.selected.longitude}}</dd></div><div><dt>Acesso terrestre</dt><dd>{{#if this.selectedHasAccess}}{{this.selected.access_latitude}}, {{this.selected.access_longitude}}{{else}}Não informado{{/if}}</dd></div></dl><div class="sig-detail-actions">{{#if this.canWrite}}{{#if this.selectedCanIssue}}<Button @type="primary" @text="Emitir OS" @disabled={{not this.selectedHasAccess}} @onClick={{fn this.openForm "order"}} />{{/if}}{{#if this.selectedCanTransition}}<Button @text="Atualizar situação" @onClick={{fn this.openForm "status"}} />{{/if}}{{/if}}</div><h3 class="sig-linked-heading">Ordens vinculadas</h3>{{#each this.orders as |order|}}<p class="sig-linked"><strong>{{order.order_number}}</strong><span class="sig-badge">{{order.order_status}}</span></p>{{else}}<p class="sig-muted">Nenhuma OS vinculada a esta solicitação.</p>{{/each}}</section>{{/if}}
      <div class="sig-table-scroll"><table class="sig-table"><thead><tr><th>Protocolo / categoria</th><th>Reservatório</th><th>Prioridade</th><th>Situação</th><th>Acesso</th><th><span class="sr-only">Ações</span></th></tr></thead><tbody>{{#each this.requestRows as |item|}}<tr><td><strong>{{item.protocol}}</strong><small>{{item.category}}</small></td><td>{{item.reservoirName}}</td><td><span class="sig-badge sig-priority-{{item.priority}}">{{item.priorityLabel}}</span></td><td>{{item.statusLabel}}</td><td>{{#if item.hasAccess}}<span class="sig-access-ok">Informado</span>{{else}}<span class="sig-access-missing">Pendente</span>{{/if}}</td><td><Button @text="Detalhes" @onClick={{fn this.selectRequest item}} /></td></tr>{{else}}<tr><td colspan="6"><div class="sig-empty"><FaIcon @icon="clipboard-list" /><h3>Nenhuma solicitação encontrada</h3><p>Cadastre uma solicitação ou altere os filtros para começar.</p></div></td></tr>{{/each}}</tbody></table></div><div class="sig-pagination"><span>Página {{this.page}} de {{this.lastPage}}</span><div><Button @text="Anterior" @disabled={{or this.busy (not this.hasPrevious)}} @onClick={{fn this.changePage -1}} /><Button @text="Próxima" @disabled={{or this.busy (not this.hasNext)}} @onClick={{fn this.changePage 1}} /></div></div></section>
      {{#if this.canWrite}}<section class="sig-card sig-import"><div><h3>Importar solicitações</h3><p class="sig-muted">CSV UTF-8 com cabeçalho · até 100 linhas e 2 MiB. O lote só será salvo se todos os registros forem válidos.</p><a href="/sig-uhe-exemplo.csv" download>Baixar modelo de CSV</a></div><div class="sig-field"><label for="sig-csv">Selecionar arquivo CSV</label><input id="sig-csv" type="file" accept=".csv,text/csv" disabled={{this.saving}} {{on "change" this.importCsv}} /></div></section>{{/if}}
    {{/if}}
    {{#if this.isPlants}}
      <section class="sig-card"><div class="sig-card-heading"><div><h2>Usinas hidrelétricas</h2><p class="sig-muted">Cadastro de empreendimentos e reservatórios</p></div>{{#if this.canWrite}}<Button @text="Cadastrar UHE" @type="primary" @icon="plus" @onClick={{fn this.openForm "plant"}} />{{/if}}</div><div class="sig-table-scroll"><table class="sig-table"><thead><tr><th>Código</th><th>Usina</th><th>UF</th></tr></thead><tbody>{{#each this.plants as |plant|}}<tr><td><strong>{{plant.code}}</strong></td><td>{{plant.name}}</td><td>{{plant.state}}</td></tr>{{else}}<tr><td colspan="3"><div class="sig-empty"><FaIcon @icon="water" /><h3>Cadastre a primeira UHE</h3><p>As solicitações serão organizadas pelos reservatórios de cada usina.</p></div></td></tr>{{/each}}</tbody></table></div></section>
      <section class="sig-card"><div class="sig-card-heading"><h2>Reservatórios</h2>{{#if this.canWrite}}<Button @text="Cadastrar reservatório" @icon="plus" @disabled={{not this.plants.length}} @onClick={{fn this.openForm "reservoir"}} />{{/if}}</div><div class="sig-table-scroll"><table class="sig-table"><thead><tr><th>Reservatório</th><th>UHE</th></tr></thead><tbody>{{#each this.reservoirRows as |reservoir|}}<tr><td><strong>{{reservoir.name}}</strong><small>ID para importação: {{reservoir.id}}</small></td><td>{{reservoir.plantName}}</td></tr>{{else}}<tr><td colspan="2"><div class="sig-empty"><p>Nenhum reservatório cadastrado.</p></div></td></tr>{{/each}}</tbody></table></div></section>
    {{/if}}
    {{#if this.isTeams}}<section class="sig-card"><div class="sig-card-heading"><div><h2>Equipes de inspeção</h2><p class="sig-muted">Equipes operacionais do Fleet-Ops</p></div>{{#if this.canWrite}}<Button @type="primary" @text="Cadastrar equipe" @icon="plus" @onClick={{fn this.openForm "team"}} />{{/if}}</div><div class="sig-table-scroll"><table class="sig-table"><thead><tr><th>Equipe</th><th>Identificador operacional</th><th>Disponibilidade</th><th>Habilidades</th><th></th></tr></thead><tbody>{{#each this.teamRows as |team|}}<tr><td><strong>{{team.name}}</strong></td><td>{{team.public_id}}</td><td>{{team.profileLabel}}</td><td>{{or team.skillsLabel "Não informadas"}}</td><td><Button @text="Perfil operacional" @onClick={{fn this.openProfile team}} /></td></tr>{{else}}<tr><td colspan="2"><div class="sig-empty"><FaIcon @icon="users" /><h3>Nenhuma equipe cadastrada</h3><p>Cadastre as equipes antes de preparar a programação das inspeções.</p></div></td></tr>{{/each}}</tbody></table></div></section>{{/if}}
    {{#if this.isAudit}}<section class="sig-card"><div class="sig-card-heading"><div><h2>Histórico de operações</h2><p class="sig-muted">Eventos auditáveis da organização</p></div></div><div class="sig-table-scroll"><table class="sig-table"><thead><tr><th>Data e hora (UTC)</th><th>Operação</th><th>Registro</th><th>Responsável</th></tr></thead><tbody>{{#each this.auditRows as |event|}}<tr><td>{{event.created_at}}</td><td><strong>{{event.label}}</strong></td><td class="sig-id">{{event.subject_id}}</td><td class="sig-id">{{event.actor_uuid}}</td></tr>{{else}}<tr><td colspan="4"><div class="sig-empty"><p>Não há eventos registrados.</p></div></td></tr>{{/each}}</tbody></table></div><div class="sig-pagination"><span>Página {{this.auditPage}} de {{this.auditLastPage}}</span><div><Button @text="Anterior" @disabled={{or this.busy (not this.hasAuditPrevious)}} @onClick={{fn this.changeAuditPage -1}} /><Button @text="Próxima" @disabled={{or this.busy (not this.hasAuditNext)}} @onClick={{fn this.changeAuditPage 1}} /></div></div></section>{{/if}}
  {{/if}}
  <footer class="sig-footer">SIG-UHE · Núcleo operacional <span>Dados da organização autenticada</span></footer>
</div>
